{
  "crons": [
    {
      "path": "/api/cron/reset-mcoins",
      "schedule": "0 0 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/tmdb-img/:path*",
      "destination": "https://image.tmdb.org/t/p/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-production-934a.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
  
}
