# API Configuration
# The frontend will proxy API requests to /api/v1/*
# In development, update vite.config.ts proxy target if API runs on different port

# TMDB API Key (required for movie/series metadata)
VITE_TMDB_API_KEY=your-tmdb-api-key-here

# Admin username (for admin panel access)
VITE_OSCAR_ADMIN_USERNAME=admin

# Public app URL (for sharing features)
VITE_PUBLIC_APP_URL=http://localhost:5173
