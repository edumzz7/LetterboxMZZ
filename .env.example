# API Configuration
# In development: Leave empty to use Vite proxy (see vite.config.ts)
# In production: Set to your backend API URL (e.g., https://api-production-934a.up.railway.app/api/v1)
VITE_API_BASE_URL=

# TMDB API Key (required for movie/series metadata)
VITE_TMDB_API_KEY=your-tmdb-api-key-here

# Admin username (for admin panel access)
VITE_OSCAR_ADMIN_USERNAME=admin

# Public app URL (for sharing features)
VITE_PUBLIC_APP_URL=http://localhost:5173

VITE_API_BASE_URL=https://api-production-934a.up.railway.app/api/v1